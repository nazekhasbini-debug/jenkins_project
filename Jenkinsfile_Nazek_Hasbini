pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}\\${VIRTUAL_ENV}")) {
                        bat "python -m venv ${VIRTUAL_ENV}"
                    }
                    bat "${VIRTUAL_ENV}\\Scripts\\pip install -r requirements.txt"
                }
            }
        }

        stage('Lint') {
            steps {
                bat "${VIRTUAL_ENV}\\Scripts\\flake8 app.py deploy.py"
            }
        }

        stage('Test') {
            steps {
                bat "${VIRTUAL_ENV}\\Scripts\\pytest"
            }
        }

        stage('Coverage') {
            steps {
                bat "${VIRTUAL_ENV}\\Scripts\\coverage run -m pytest"
                bat "${VIRTUAL_ENV}\\Scripts\\coverage report -m"
                bat "${VIRTUAL_ENV}\\Scripts\\coverage html"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'htmlcov/**', allowEmptyArchive: true
                }
            }
        }

        stage('Security Scan') {
            steps {
                bat "${VIRTUAL_ENV}\\Scripts\\bandit -r app.py deploy.py conftest.py tests -f txt -o bandit-report.txt --exit-zero"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'bandit-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application..."
                    bat "${VIRTUAL_ENV}\\Scripts\\python deploy.py"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
